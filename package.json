{
	"name": "tmerge",
	"version": "0.0.1",
	"description": "Merge and unmerge translations using advanced features.",
	"type": "module",
	"scripts": {
		"build": "rollpkg build --noStats",
		"watch": "rollpkg watch",
		"lint": "eslint --fix",
		"prepublishOnly": "npm run build",
		"prepare": "husky"
	},
	"dependencies": {
		"commander": "^13.1.0",
		"modern-errors": "^7.0.2",
		"modern-errors-bugs": "^5.0.0",
		"modern-errors-clean": "^6.0.0",
		"modern-errors-winston": "^5.0.1",
		"radash": "^12.1.0",
		"winston": "^3.17.0",
		"zod": "^3.24.2",
		"zod-validation-error": "^3.4.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.8.0",
		"@commitlint/config-conventional": "^19.8.0",
		"@eslint/compat": "^1.2.7",
		"@eslint/js": "^9.23.0",
		"@stylistic/eslint-plugin": "^4.2.0",
		"@types/node": "^22.13.11",
		"eslint": "^9.23.0",
		"eslint-plugin-unicorn": "^57.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.0",
		"rollpkg": "^0.5.7",
		"tslib": "^2.8.1",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.27.0"
	},
	"lint-staged": {
		"*": [
			"pnpm lint"
		]
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"main": "dist/tmerge.cjs.js",
	"module": "dist/tmerge.esm.js",
	"types": "dist/index.d.ts",
	"sideEffects": false,
	"files": [
		"dist",
		"bin"
	],
	"bin": {
		"tmerge": "bin/tmerge.js"
	},
	"keywords": [],
	"author": "Ronald Torrez",
	"license": "ISC",
	"packageManager": "pnpm@10.7.0",
	"pnpm": {
		"onlyBuiltDependencies": [
			"@parcel/watcher",
			"core-js",
			"core-js-pure",
			"esbuild",
			"fsevents"
		]
	}
}
